@page "/login"
@attribute [AllowAnonymous]

@using InfraDocs.BlazorServer.Services
@inject AuthService AuthService
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height:100vh;">
    <MudPaper Elevation="8" Class="pa-6" Style="width:100%; max-width:420px;">

        <MudStack Spacing="3">

            <MudAvatar Icon="@Icons.Material.Filled.Person"
                       Size="Size.Large"
                       Color="Color.Primary"
                       Class="mx-auto">
                <MudIcon Color="Color.Surface" Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
            </MudAvatar>

            <MudText Typo="Typo.h5" Align="Align.Center">
                Login
            </MudText>

            <MudTextField T="string"
                          Label="Email"
                          Variant="Variant.Outlined"
                          @bind-Value="_email"
                          FullWidth />

            <MudTextField T="string"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          FullWidth />
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Align="Align.Center">
                    @_error
                </MudText>
            }

            <MudCheckBox T="bool"
                         @bind-Checked="_rememberMe"
                         Label="Remember me" />

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth
                       OnClick="LoginAsync">
                LOGIN
            </MudButton>

        </MudStack>

    </MudPaper>
</MudContainer>


@code {
    private string _email = "anderson.infosistemas@gmail.com";
    private bool _rememberMe;
    private string? _error;

    private async Task LoginAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_email))
        {
            _error = "Informe o e-mail.";
            return;
        }

        var success = await AuthService.LoginAsync(_email);

        if (!success)
        {
            _error = "Falha no login.";
            return;
        }

        await InvokeAsync(StateHasChanged);
        Nav.NavigateTo("/", forceLoad: true);
    }
}
