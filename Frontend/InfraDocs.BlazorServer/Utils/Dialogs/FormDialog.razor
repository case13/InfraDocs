@using Microsoft.AspNetCore.Components
@using MudBlazor

<MudDialog>
    <TitleContent>
        @Title
    </TitleContent>
        
    <DialogContent>
        <div style="max-height:72vh; overflow:auto; overflow-x:hidden;">
            @if (BodyComponent is not null)
            {
                <DynamicComponent Type="BodyComponent" Parameters="BodyParameters" />
            }
            else
            {
                @ChildContent
            }
        </div>
    </DialogContent>

    <DialogActions>
       @if (ShowActions)
       {
    
            @if (Actions is not null)
            {
                @Actions
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Close">Fechar</MudButton>
            }
       }
    </DialogActions>

</MudDialog>


@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    
    // Título do diálogo
    [Parameter] public string? Title { get; set; }

    // Opção para mostrar/ocultar barra de ações padrão
    [Parameter] public bool ShowActions { get; set; } = true;

    // Slot opcional para ações customizadas
    [Parameter] public RenderFragment? Actions { get; set; }

    // Caso queira renderizar um componente como corpo
    [Parameter] public Type? BodyComponent { get; set; }
    [Parameter] public IDictionary<string, object?>? BodyParameters { get; set; }

    // Alternativamente, pode usar o próprio conteúdo como corpo
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
